# Copiar a .env (producción, docker-compose.yml) o a .env.develop (docker-compose.dev.yml). Ninguno se versiona.

# Gateway del OTP: mismo contrato que GATEWAY_URL / X_API_KEY de go_otp_verify.
# Sandbox (el código aparece en la PWA de otp-show, no se envía SMS):
OTP_URL=http://otp-show-app-1:5066/api/otps
# Producción: la URL del webhook de SMS.
# OTP_URL=https://auto.server.gt/webhook/<id>

# Cabecera x-api-key; vacía = no se envía (otp-show no la necesita).
OTP_API_KEY=

# Valor del campo "channel" del payload.
OTP_CHANNEL=1

# JWT_SECRET también se puede fijar aquí; si no, se usa el de docker-compose.yml.
# JWT_SECRET=

# PostgreSQL: DATABASE_URL tiene prioridad sobre las variables DB_*.
# DATABASE_URL=postgres://sharedata_app:password@postgres:5432/sharedata_dev?sslmode=disable
# DB_HOST=postgres-db
# DB_PORT=5432
# DB_USER=sharedata_app
# DB_PASSWORD=
# DB_NAME=sharedata_dev
# DB_SSLMODE=disable
# TLS=false  # detrás del proxy HTTPS
